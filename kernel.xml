<?xml version="1.0" encoding="UTF-8"?>
<manifest>
  <remote name="flopster" fetch="https://github.com/flopster101" sync-c="true"/>

  <!-- s5e8855 kernel -->
  <project path="common" name="kernel_platform_common-s5e8855" revision="rebase/initial" remote="flopster" clone-depth="1"/>

  <!-- s5e8855 Device -->
  <project path="vendor/samsung/prebuilts" name="kernel_platform_prebuilt" revision="main" remote="flopster" clone-depth="1">
    <linkfile src="boot-artifacts" dest="prebuilts/boot-artifacts" />
    <linkfile src="platform" dest="prebuilts/platform" />
  </project>

  <!-- Kernel Platform -->
  <project path="kernel_platform/kernel_device_samsung_gts10fewifi" name="kernel_device_samsung_gts10fewifi" revision="main" remote="flopster" clone-depth="1">

    <!-- devices -->
    <linkfile src="device" dest="exynos/device" />
    <linkfile src="device/erd/erd9945/device.bazelrc" dest=".d1.bazelrc" />
    <linkfile src="device/erd/erd9955/device.bazelrc" dest=".d2.bazelrc" />
    <linkfile src="device/mx/mx8855/device.bazelrc" dest=".d3.bazelrc" />

    <!-- modules -->
    <linkfile src="external-modules" dest="exynos/external-modules" />

    <!-- SoC -->
    <linkfile src="soc-series" dest="exynos/soc-series" />
    <linkfile src="soc-series/s-android15/device.bazelrc" dest="device.bazelrc" />
    <linkfile src="soc-series/common/bazel.WORKSPACE" dest="WORKSPACE" />
    
    <!-- README -->
    <linkfile src="README.md" dest="README.md" />
  </project>

  <!-- Build script -->
  <project name="kernel_platform_script" path="kernel_platform/script" revision="main" remote="flopster">
    <linkfile dest="build.sh" src="build.sh" />
  </project>
</manifest>
